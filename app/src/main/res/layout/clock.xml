<?xml version="1.0" encoding="utf-8"?>
<!--
    Header seperti contoh: pojok kiri atas ikon settings, jam besar (AM/PM kecil) di kiri,
    cuaca di kanan, lalu tanggal + 5 waktu sholat (pengganti baris forecast) di bawah.
    Kartu semi-transparan dengan outline putih tipis (rounded).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_card_bg"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="3dp"
    android:paddingEnd="12dp"
    android:paddingBottom="3dp">

    <!-- Baris 1: settings (kiri) + deskripsi cuaca (kanan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/settings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:clickable="true"
            android:contentDescription="@string/launcher_settings"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp">

                <ImageView
                    android:id="@+id/settings_selection_circle"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:alpha="0.0"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/settings_selection_circle" />

                <ImageView
                    android:id="@+id/settings_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:alpha="1.0"
                    android:contentDescription="@null"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- "chip" deskripsi cuaca seperti "Partly cloudy" di contoh -->
            <TextView
                android:id="@+id/wDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/prayer_chip_bg"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxWidth="190dp"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:singleLine="true"
                android:textColor="@color/clock_text_color"
                android:textSize="12sp" />

            <!-- Tidak ditampilkan di desain baru; id dipertahankan karena MainActivity mengisinya. -->
            <TextView
                android:id="@+id/humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pressure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Baris 2: jam besar (kiri) + suhu / hi-lo / ikon cuaca (kanan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.amazon.tv.leanbacklauncher.clock.ClockView
                android:id="@id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/clock_text_color"
                android:textSize="38sp"
                android:textStyle="bold" />

            <!-- AM/PM kecil di samping jam (kosong pada format 24 jam) -->
            <TextClock
                android:id="@+id/clock_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="5dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/prayer_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/curTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/clock_text_color"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hilotemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/prayer_text_muted"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/weather_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/weather01d" />
        </LinearLayout>
    </LinearLayout>

    <!-- Baris 3 + 4: tanggal (+ "berikutnya") lalu 5 kolom waktu sholat -->
    <com.amazon.tv.leanbacklauncher.wallpaper.PrayerTimesOverlay
        android:id="@+id/prayer_times_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
