<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu kartu: pengaturan + jam + cuaca + jadwal sholat.
  Baris 1 : [pengaturan] [jam] ...... [ikon+suhu] [deskripsi / kelembapan]
  Baris 2+: PrayerTimesOverlay (kota · tanggal · "berikutnya", lalu 5 waktu sholat)
  Semua id lama dipertahankan karena dipakai MainActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_card_bg"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- settings (tetap LinearLayout: MainActivity melakukan cast ke LinearLayout) -->
        <LinearLayout
            android:id="@+id/settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:contentDescription="@string/launcher_settings"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/settings_selection_circle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:alpha="0.0"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/settings_selection_circle" />

                <ImageView
                    android:id="@+id/settings_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:alpha="1.0"
                    android:contentDescription="@null"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>
        </LinearLayout>

        <!-- clock -->
        <com.amazon.tv.leanbacklauncher.clock.ClockView
            android:id="@id/clock"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:focusable="false"
            android:fontFamily="@string/light_font"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/clock_text_color"
            android:textSize="32sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- weather: ikon + suhu -->
        <LinearLayout
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/weather_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:src="@drawable/weather01d" />

            <TextView
                android:id="@+id/curTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:focusable="false"
                android:fontFamily="@string/light_font"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/clock_text_color"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- weather: deskripsi + kelembapan + min/maks -->
        <LinearLayout
            android:id="@+id/details"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/wDescription"
                android:layout_width="116dp"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="6dp"
                android:fontFamily="@string/light_font"
                android:includeFontPadding="false"
                android:marqueeRepeatLimit="marquee_forever"
                android:requiresFadingEdge="horizontal"
                android:singleLine="true"
                android:textColor="@color/clock_text_color"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/humidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@string/light_font"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/prayer_text_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/hilotemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@string/light_font"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/prayer_text_muted"
                    android:textSize="11sp" />

                <!-- Keep the weather fields used by MainActivity while keeping them compact. -->
                <TextView
                    android:id="@+id/pressure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@string/light_font"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/prayer_text_muted"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/wind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@string/light_font"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/prayer_text_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- jadwal sholat: bagian dari kartu yang sama -->
    <com.amazon.tv.leanbacklauncher.wallpaper.PrayerTimesOverlay
        android:id="@+id/prayer_times_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

</LinearLayout>
